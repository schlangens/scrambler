# HTTP port the Express server listens on. Defaults to 3057 if not set.
PORT=3057

# Maximum time (in milliseconds) the server will wait for the Python PDF
# redactor to finish one request. Defaults to 60000.
SCRAMBLER_REDACT_TIMEOUT_MS=60000

# Maximum PDF upload size (in bytes) that the Python redactor will accept.
# Defaults to 10485760 (10 MB).
SCRAMBLER_MAX_FILE_SIZE=10485760
